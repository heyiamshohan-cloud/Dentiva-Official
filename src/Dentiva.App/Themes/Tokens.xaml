<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      Dentiva design tokens — the single source of visual truth.
      Light theme only. Cool clinical neutrals + restrained brand teal.
    -->

    <!-- ===== Palette ===== -->
    <Color x:Key="Color.Canvas">#F4F6F9</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FAFBFD</Color>
    <Color x:Key="Color.SurfaceSunken">#EEF2F6</Color>

    <Color x:Key="Color.BorderSubtle">#E4E9F0</Color>
    <Color x:Key="Color.Border">#D4DCE5</Color>
    <Color x:Key="Color.BorderStrong">#B9C4D0</Color>

    <Color x:Key="Color.Ink">#182734</Color>
    <Color x:Key="Color.InkSecondary">#4E5F6E</Color>
    <Color x:Key="Color.InkTertiary">#7E8FA0</Color>
    <Color x:Key="Color.InkDisabled">#AEBBC7</Color>

    <Color x:Key="Color.Accent">#0E7490</Color>
    <Color x:Key="Color.AccentHover">#0B637D</Color>
    <Color x:Key="Color.AccentPressed">#09536A</Color>
    <Color x:Key="Color.AccentSubtle">#E7F4F8</Color>
    <Color x:Key="Color.AccentBorder">#BFE1EB</Color>
    <Color x:Key="Color.AccentInk">#0A5E76</Color>

    <Color x:Key="Color.Success">#177E52</Color>
    <Color x:Key="Color.SuccessSubtle">#E6F5EE</Color>
    <Color x:Key="Color.SuccessBorder">#BCE3D0</Color>

    <Color x:Key="Color.Warning">#A9660B</Color>
    <Color x:Key="Color.WarningSubtle">#FBF2E1</Color>
    <Color x:Key="Color.WarningBorder">#F0DCB4</Color>

    <Color x:Key="Color.Danger">#B23A2E</Color>
    <Color x:Key="Color.DangerSubtle">#FBEDEA</Color>
    <Color x:Key="Color.DangerBorder">#F0C7C0</Color>

    <Color x:Key="Color.Info">#2B6394</Color>
    <Color x:Key="Color.InfoSubtle">#EAF1F8</Color>
    <Color x:Key="Color.InfoBorder">#C6D9EA</Color>

    <Color x:Key="Color.Shadow">#1A3550</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />

    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.InkSecondary" Color="{StaticResource Color.InkSecondary}" />
    <SolidColorBrush x:Key="Brush.InkTertiary" Color="{StaticResource Color.InkTertiary}" />
    <SolidColorBrush x:Key="Brush.InkDisabled" Color="{StaticResource Color.InkDisabled}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="{StaticResource Color.AccentBorder}" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource Color.AccentInk}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="{StaticResource Color.SuccessSubtle}" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="{StaticResource Color.SuccessBorder}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{StaticResource Color.WarningSubtle}" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{StaticResource Color.DangerSubtle}" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="{StaticResource Color.DangerBorder}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoSubtle" Color="{StaticResource Color.InfoSubtle}" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="{StaticResource Color.InfoBorder}" />

    <!-- ===== Typography ===== -->
    <!-- Font families are installed from Assets/Fonts at startup; defaults
         resolve to Segoe UI if resource fonts are unavailable. -->
    <FontFamily x:Key="Font.Base">pack://application:,,,/Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="Font.Medium">pack://application:,,,/Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
    <FontFamily x:Key="Font.SemiBold">pack://application:,,,/Assets/Fonts/Inter-SemiBold.ttf#Inter SemiBold</FontFamily>
    <FontFamily x:Key="Font.Bold">pack://application:,,,/Assets/Fonts/Inter-Bold.ttf#Inter Bold</FontFamily>
    <FontFamily x:Key="Font.Bengali">pack://application:,,,/Assets/Fonts/NotoSansBengali-Regular.ttf#Noto Sans Bengali</FontFamily>
    <FontFamily x:Key="Font.BengaliSemiBold">pack://application:,,,/Assets/Fonts/NotoSansBengali-SemiBold.ttf#Noto Sans Bengali SemiBold</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Display">26</sys:Double>

    <!-- ===== Radii & spacing ===== -->
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.ControlLarge">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Thickness x:Key="Spacing.CardPadding">20</Thickness>
    <Thickness x:Key="Spacing.PagePadding">28</Thickness>

    <!-- ===== Elevation ===== -->
    <DropShadowEffect x:Key="Shadow.Card" Color="{StaticResource Color.Shadow}" Opacity="0.08" BlurRadius="18" ShadowDepth="3" Direction="270" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Flyout" Color="{StaticResource Color.Shadow}" Opacity="0.14" BlurRadius="28" ShadowDepth="6" Direction="270" />
    <DropShadowEffect x:Key="Shadow.Dialog" Color="{StaticResource Color.Shadow}" Opacity="0.22" BlurRadius="44" ShadowDepth="10" Direction="270" />

</ResourceDictionary>
