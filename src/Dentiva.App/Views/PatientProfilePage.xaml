<UserControl x:Class="Dentiva.App.Views.PatientProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26" MaxWidth="1560" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Patient header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Brush.AccentSubtle}">
                    <TextBlock x:Name="Initials" Text="?" FontSize="19" FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{StaticResource Brush.AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameText" Style="{StaticResource Text.Subtitle}" />
                        <Border x:Name="StatusBadge" Background="{StaticResource Brush.SuccessSubtle}" CornerRadius="999" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Active" FontSize="10.5" FontFamily="{DynamicResource Font.Medium}" Foreground="{StaticResource Brush.Success}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="CodeText" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="MetaText" Style="{StaticResource Text.Caption}" Margin="14,0,0,0" />
                        <TextBlock x:Name="PhoneText" Style="{StaticResource Text.Caption}" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Outstanding" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="BalanceText" Text="0" FontFamily="{DynamicResource Font.SemiBold}" FontSize="16" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button x:Name="NewVisitButton" Style="{StaticResource PrimaryButton}" Padding="13,7" Click="OnNewVisit">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Record Visit" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewAppointmentButton" Style="{StaticResource TintedButton}" Padding="13,7" Margin="10,0,0,0" Click="OnNewAppointment">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Book" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Background="Transparent">
            <TabControl.Items>
                <TabItem Header="Clinical" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Clinical Summary" Style="{StaticResource Text.BodyEmphasis}" Margin="0,0,0,10" />
                                        <TextBlock x:Name="ClinicalSummary" Style="{StaticResource Text.Small}" TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Alerts &amp; Risk Factors" Style="{StaticResource Text.BodyEmphasis}" Margin="0,0,0,10" />
                                        <TextBlock x:Name="AlertsText" Style="{StaticResource Text.Small}" TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Dental Chart" Style="{StaticResource Text.BodyEmphasis}" Margin="20,14,0,8" />
                                    <Separator Margin="0" />
                                    <ContentControl x:Name="ToothChartHost" Margin="20,12,20,16" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Visit History" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <ItemsControl x:Name="VisitsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VisitDate, Converter={StaticResource DateTimeConverter}}" FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.Body}" />
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DoctorName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Diagnosis}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Diagnosis, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Appointments" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <ItemsControl x:Name="AppointmentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AppointmentDate, Converter={StaticResource DateConverter}}" FontFamily="{DynamicResource Font.Medium}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StartTime, Converter={StaticResource TimeConverter}}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AppointmentType}" Style="{StaticResource Text.Secondary}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Serial" Style="{StaticResource Text.Caption}" Margin="16,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SerialNumber}" FontFamily="{DynamicResource Font.SemiBold}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}"
                                                    CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                                           FontSize="11" FontFamily="{DynamicResource Font.Medium}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Billing" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <ItemsControl x:Name="InvoicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8" MouseLeftButtonDown="OnOpenInvoice"
                                            Cursor="Hand" Tag="{Binding Id}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding InvoiceNumber}" FontFamily="{DynamicResource Font.Medium}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InvoiceDate, Converter={StaticResource DateConverter}}" Style="{StaticResource Text.Secondary}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalMinor, Converter={StaticResource MoneyConverter}}" FontFamily="{DynamicResource Font.SemiBold}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DueMinor, Converter={StaticResource MoneyConverter}}" Style="{StaticResource Text.Small}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                <Border Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}" CornerRadius="999" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                                               FontSize="11" FontFamily="{DynamicResource Font.Medium}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Medications" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <ItemsControl x:Name="MedicationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Medium}" />
                                                <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0">
                                                    <Run Text="{Binding Strength}" /><Run Text="  ·  " /><Run Text="{Binding Dosage}" /><Run Text="  ·  " /><Run Text="{Binding Frequency}" /><Run Text="  ·  " /><Run Text="{Binding Duration}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Instructions}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PrescribedDate, Converter={StaticResource DateConverter}}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Referrals" Style="{StaticResource UnderlineTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <ItemsControl x:Name="ReferralsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Provider}" FontFamily="{DynamicResource Font.Medium}" />
                                                    <TextBlock Text="{Binding Specialty}" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReferralDate, Converter={StaticResource DateConverter}}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Organization}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl.Items>
        </TabControl>
    </Grid>
</UserControl>
