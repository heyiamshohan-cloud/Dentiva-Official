<UserControl x:Class="Dentiva.App.Views.BillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Billing" Style="{StaticResource Text.PageTitle}" />
                <TextBlock x:Name="SummaryLine" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="36" Tag="Search by invoice no, patient or code"
                         TextChanged="OnSearchChanged" />
                <ComboBox x:Name="StatusFilter" Grid.Column="1" Width="150" Height="36" Margin="14,0,0,0"
                          SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="All invoices" IsSelected="True" />
                    <ComboBoxItem Content="Unpaid" />
                    <ComboBoxItem Content="Partially paid" />
                    <ComboBoxItem Content="Paid" />
                    <ComboBoxItem Content="Voided" />
                </ComboBox>
                <ComboBox x:Name="ScopeFilter" Grid.Column="2" Width="150" Height="36" Margin="14,0,0,0"
                          SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="All time" />
                    <ComboBoxItem Content="Today" IsSelected="True" />
                    <ComboBoxItem Content="Last 7 days" />
                    <ComboBoxItem Content="This month" />
                </ComboBox>
                <ComboBox x:Name="OutstandingFilter" Grid.Column="3" Width="150" Height="36" Margin="14,0,0,0"
                          SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="All balances" IsSelected="True" />
                    <ComboBoxItem Content="With due only" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="InvoicesGrid" ItemsSource="{Binding}" RowHeight="46" MouseDoubleClick="OnOpenInvoice">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="140" />
                    <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Converter={StaticResource DateConverter}}" Width="110" />
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="200" />
                    <DataGridTextColumn Header="Code" Binding="{Binding PatientCode}" Width="96" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding PaidMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                    <DataGridTextColumn Header="Due" Binding="{Binding DueMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}"
                                        CornerRadius="999" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                               FontSize="11" FontFamily="{DynamicResource Font.Medium}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="PageInfo" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevButton" Content="&#xE76B;" Style="{StaticResource IconButton}" Width="34" Click="OnPrevPage" />
                <Button x:Name="NextButton" Content="&#xE76C;" Style="{StaticResource IconButton}" Width="34" Click="OnNextPage" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
