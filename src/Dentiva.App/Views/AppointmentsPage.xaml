<UserControl x:Class="Dentiva.App.Views.AppointmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Appointments" Style="{StaticResource Text.PageTitle}" />
                <TextBlock x:Name="SubtitleLine" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="OnNewAppointment">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="New Appointment" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Day header: date navigation + summary chips -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevDayButton" Content="&#xE76B;" Style="{StaticResource IconButton}" Click="OnPrevDay" ToolTip="Previous day" />
                    <DatePicker x:Name="DayPicker" Width="150" Height="34" SelectedDateChanged="OnDayChanged" Margin="6,0" />
                    <Button x:Name="NextDayButton" Content="&#xE76C;" Style="{StaticResource IconButton}" Click="OnNextDay" ToolTip="Next day" />
                    <Button Content="Today" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnToday" />
                </StackPanel>
                <StackPanel x:Name="SummaryChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="QueueGrid" ItemsSource="{Binding}" RowHeight="48"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="70" />
                    <DataGridTextColumn Header="Time" Binding="{Binding StartTime, Converter={StaticResource TimeConverter}}" Width="84" />
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="200" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding PatientPhone}" Width="130" />
                    <DataGridTextColumn Header="Type" Binding="{Binding AppointmentType}" Width="130" />
                    <DataGridTextColumn Header="Doctor" Binding="{Binding DoctorName}" Width="130" />
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}"
                                        CornerRadius="999" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                               FontSize="11" FontFamily="{DynamicResource Font.Medium}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Waiting" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                            FontSize="11" Tag="{Binding Id}" Click="OnMarkWaiting" />
                                    <Button Content="Start" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                            FontSize="11" Tag="{Binding Id}" Click="OnStartConsultation" />
                                    <Button Content="Done" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,4,0"
                                            FontSize="11" Tag="{Binding Id}" Click="OnComplete" />
                                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="8,4"
                                            FontSize="11" Foreground="{StaticResource Brush.Danger}" Tag="{Binding Id}" Click="OnCancelAppointment" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
