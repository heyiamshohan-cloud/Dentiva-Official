<Window x:Class="Dentiva.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="clr-namespace:Dentiva.App.Views.Shell"
        xmlns:sysshell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Dentiva.App.Infrastructure"
        Title="Dentiva"
        Width="1440" Height="900"
        MinWidth="1160" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Brush.Canvas}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <sysshell:WindowChrome.WindowChrome>
        <sysshell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </sysshell:WindowChrome.WindowChrome>

    <Window.Resources>
        <uic:SearchKindLabelConverter x:Key="SearchKindLabel" />
        <uic:NullToCollapsedConverter x:Key="StringToVisibility" />
        <Style x:Key="NavItemRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkSecondary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="14,9" Margin="10,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="{DynamicResource Font.Medium}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.SurfaceSunken}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,14" Background="Transparent" MouseLeftButtonDown="OnDragWindow">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/logo-128.png" Width="34" Height="34" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Dentiva" FontFamily="{DynamicResource Font.Bold}" FontSize="17" Foreground="{StaticResource Brush.Ink}" />
                                <TextBlock Text="{loc:Loc app.tagline}" FontSize="10" Foreground="{StaticResource Brush.InkTertiary}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Brush.AccentSubtle}">
                                    <TextBlock x:Name="UserInitials" Text="A" FontFamily="{DynamicResource Font.SemiBold}" FontSize="13"
                                               Foreground="{StaticResource Brush.AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserDisplayName" Text="Administrator" FontFamily="{DynamicResource Font.Medium}"
                                               FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Ink}" />
                                    <TextBlock x:Name="UserRole" Text="Administrator" FontSize="10.5" Foreground="{StaticResource Brush.InkTertiary}" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SignOutButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xF3B1;"
                                    ToolTip="Sign out" Click="OnSignOut" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
                        <StackPanel x:Name="NavList" Margin="0,2,0,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Main column ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />

                        <!-- Global search -->
                        <Grid Grid.Column="2" Width="430" VerticalAlignment="Center">
                            <TextBox x:Name="GlobalSearchBox" Height="36" Tag="Search patients, invoices, visits…   Ctrl+K"
                                     TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" FontSize="{StaticResource FontSize.Small}" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                       Foreground="{StaticResource Brush.InkTertiary}" HorizontalAlignment="Left" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=GlobalSearchBox}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" MinWidth="430" MaxWidth="520">
                                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,6,0,0" Effect="{StaticResource Shadow.Flyout}"
                                        MaxHeight="420">
                                    <ListBox x:Name="SearchResults" BorderThickness="0" Padding="6"
                                             SelectionChanged="OnSearchResultSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource Brush.AccentSubtle}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding Kind, Converter={StaticResource SearchKindLabel}}" FontSize="10.5"
                                                                       FontFamily="{DynamicResource Font.Medium}"
                                                                       Foreground="{StaticResource Brush.AccentInk}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Font.Medium}"
                                                                   FontSize="{StaticResource FontSize.Small}" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="380" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{StaticResource Brush.InkTertiary}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400"
                                                               Visibility="{Binding Snippet, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Notification bell -->
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xEA8F;" Margin="16,0,4,0"
                                Click="OnNotificationsClick" ToolTip="Notifications" VerticalAlignment="Center" />
                        <Border Grid.Column="3" x:Name="NotificationBadge" Background="{StaticResource Brush.Danger}" CornerRadius="8"
                                MinWidth="16" Height="16" Margin="30,10,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="NotificationCount" Text="0" Foreground="White" FontSize="10"
                                       FontFamily="{DynamicResource Font.Medium}" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Window controls -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                            <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                            <Button x:Name="CloseButton" Style="{StaticResource WindowCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page host -->
                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Modal dialog overlay -->
        <Border x:Name="DialogOverlay" Background="#55101820" Visibility="Collapsed">
            <ContentControl x:Name="DialogContent" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="860" MaxHeight="760" />
        </Border>

        <!-- Toast host -->
        <Border x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed">
            <ItemsControl x:Name="ToastList" />
        </Border>
    </Grid>
</Window>
