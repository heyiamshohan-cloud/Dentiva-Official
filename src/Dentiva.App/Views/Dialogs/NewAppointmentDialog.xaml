<Window x:Class="Dentiva.App.Views.Dialogs.NewAppointmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Appointment"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Border Margin="16" Background="{StaticResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" Effect="{StaticResource Shadow.Dialog}">
        <StackPanel Margin="30,26">
            <TextBlock Text="New Appointment" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="The serial number is assigned automatically for the selected day and doctor."
                       Style="{StaticResource Text.Secondary}" Margin="0,4,0,20" />

            <TextBlock Text="Patient *" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PatientBox" Height="36" TextChanged="OnPatientSearch" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                           Foreground="{StaticResource Brush.InkTertiary}" HorizontalAlignment="Left" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <ListBox x:Name="PatientResults" Grid.Column="0" MaxHeight="180" Margin="0,40,0,0"
                         Visibility="Collapsed" SelectionChanged="OnPatientSelected"
                         Panel.ZIndex="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Date *" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="DateBox" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time *" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="TimeBox" Height="36" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Type" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="TypeBox" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Doctor" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="DoctorBox" Height="36" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <CheckBox x:Name="WalkInCheck" Content="Walk-in patient (assign the next free serial now)" />
            </StackPanel>

            <TextBlock Text="Notes" Style="{StaticResource FormLabel}" Margin="0,14,0,6" />
            <TextBox x:Name="NotesBox" Height="60" Style="{StaticResource MultilineTextBox}" MaxHeight="60" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Small}"
                       Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Width="104" Height="36" Margin="0,0,10,0" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="Book Appointment" Style="{StaticResource PrimaryButton}" Width="150" Height="36" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
