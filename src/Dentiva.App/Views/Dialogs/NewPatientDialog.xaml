<Window x:Class="Dentiva.App.Views.Dialogs.NewPatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Patient"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Border Margin="16" Background="{StaticResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" Effect="{StaticResource Shadow.Dialog}">
        <StackPanel Margin="30,26">
            <TextBlock Text="Add Patient" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Text="Register a new patient record. Fields marked * are required."
                       Style="{StaticResource Text.Secondary}" Margin="0,4,0,20" />

            <TextBlock Text="Full name *" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Height="36" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Phone *" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="PhoneBox" Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Date of birth" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="DobPicker" Height="36" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Gender" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="GenderBox" Height="36" SelectedIndex="0">
                        <ComboBoxItem Content="Unspecified" />
                        <ComboBoxItem Content="Female" />
                        <ComboBoxItem Content="Male" />
                        <ComboBoxItem Content="Other" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="City / area" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="CityBox" Height="36" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Chief complaint" Style="{StaticResource FormLabel}" Margin="0,14,0,6" />
            <TextBox x:Name="ComplaintBox" Height="36" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Small}"
                       Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Width="104" Height="36" Margin="0,0,10,0" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="Add Patient" Style="{StaticResource PrimaryButton}" Width="130" Height="36" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
