<Window x:Class="Dentiva.App.Views.Dialogs.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Border Margin="16" Background="{StaticResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" Effect="{StaticResource Shadow.Dialog}">
        <StackPanel Margin="30,26">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="InvoiceNumber" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock x:Name="PatientLine" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusBadge" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateLine" Style="{StaticResource Text.Small}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,16,0,8" />

            <DataGrid x:Name="ItemsGrid" MinHeight="60" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Service" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Tooth" Binding="{Binding Tooth}" Width="70" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                    <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPriceMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountMinor, Converter={StaticResource MoneyConverter}}" Width="100" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!-- Payments -->
                <StackPanel>
                    <TextBlock Text="Payments" Style="{StaticResource Text.BodyEmphasis}" />
                    <ItemsControl x:Name="PaymentsList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReceiptNumber}" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                                        <TextBlock Text="{Binding PaidAt, Converter={StaticResource DateTimeConverter}}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MethodLabel}" Style="{StaticResource Text.Small}" Margin="10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding AmountMinor, Converter={StaticResource MoneyConverter}}"
                                               FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.Small}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoPaymentsText" Text="No payments recorded yet." Style="{StaticResource Text.Small}" Margin="0,8,0,0" />

                    <Button x:Name="RecordPaymentButton" Style="{StaticResource TintedButton}" Padding="12,7" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Click="OnRecordPayment">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Record Payment" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Totals -->
                <Border Grid.Column="1" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="10" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Subtotal" Style="{StaticResource Text.Small}" />
                            <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Discount" Style="{StaticResource Text.Small}" />
                            <TextBlock x:Name="DiscountText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Tax" Style="{StaticResource Text.Small}" />
                            <TextBlock x:Name="TaxText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                        </Grid>
                        <Separator Margin="0,10,0,10" />
                        <Grid>
                            <TextBlock Text="Grand total" FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.Body}" />
                            <TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.BodyLarge}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Paid" Style="{StaticResource Text.Small}" />
                            <TextBlock x:Name="PaidText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Balance due" FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.Body}" />
                            <TextBlock x:Name="DueText" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.SemiBold}" FontSize="{StaticResource FontSize.BodyLarge}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Small}" Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="VoidButton" Content="Void invoice" Style="{StaticResource GhostButton}" Foreground="{StaticResource Brush.Danger}"
                        Margin="0,0,10,0" Click="OnVoid" />
                <Button Content="Close" Width="104" Height="36" Style="{StaticResource PrimaryButton}" Click="OnClose" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
