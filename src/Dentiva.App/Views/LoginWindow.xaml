<Window x:Class="Dentiva.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Dentiva.App.Infrastructure"
        Title="Dentiva — Sign in"
        Width="960" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="False">
    <Border Background="{StaticResource Brush.Canvas}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Accent}" Margin="0,24,0,24" CornerRadius="0,0,0,0">
                <StackPanel VerticalAlignment="Center" Margin="48,0">
                    <Image Source="/Assets/logo-256.png" Width="96" Height="96" HorizontalAlignment="Left" />
                    <TextBlock Text="Dentiva" FontFamily="{DynamicResource Font.Bold}" FontSize="34" Foreground="White" Margin="0,28,0,0" />
                    <TextBlock Text="{loc:Loc app.tagline}" FontSize="{StaticResource FontSize.BodyLarge}"
                               Foreground="#CDE9F0" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sign-in card -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                    CornerRadius="12" Padding="40,44" VerticalAlignment="Center" Effect="{StaticResource Shadow.Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc login.title}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{loc:Loc app.tagline}" Style="{StaticResource Text.Small}" Margin="0,4,0,28" />

                    <TextBlock Text="{loc:Loc login.username}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameBox" Tag="admin" Height="38" />

                    <TextBlock Text="{loc:Loc login.password}" Style="{StaticResource FormLabel}" Margin="0,18,0,6" />
                    <PasswordBox x:Name="PasswordBox" Height="38" KeyDown="OnPasswordKeyDown" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" FontSize="{StaticResource FontSize.Small}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                    <Button x:Name="SignInButton" Content="{loc:Loc login.signIn}" Style="{StaticResource PrimaryButton}"
                            Height="40" Margin="0,24,0,0" Click="OnSignIn" IsDefault="True" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                    Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnClose" ToolTip="Close" />
        </Grid>
    </Border>
</Window>
