<UserControl x:Class="Dentiva.App.Views.PatientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Patients" Style="{StaticResource Text.PageTitle}" />
                <TextBlock x:Name="CountLine" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="OnNewPatient">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="New Patient" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="36" VerticalAlignment="Center"
                         Tag="Search by name, patient code or phone" TextChanged="OnSearchChanged" />
                <ComboBox x:Name="StatusFilter" Grid.Column="1" Width="140" Height="36" Margin="14,0,0,0"
                          VerticalAlignment="Center" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All statuses" IsSelected="True" />
                    <ComboBoxItem Content="Active" />
                    <ComboBoxItem Content="Inactive" />
                    <ComboBoxItem Content="Archived" />
                </ComboBox>
                <ComboBox x:Name="BalanceFilter" Grid.Column="2" Width="170" Height="36" Margin="14,0,0,0"
                          VerticalAlignment="Center" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All balances" IsSelected="True" />
                    <ComboBoxItem Content="With outstanding balance" />
                </ComboBox>
                <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnResetFilters" />
            </Grid>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="PatientsGrid" ItemsSource="{Binding}" RowHeight="46"
                      MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="96" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="220" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130" />
                    <DataGridTemplateColumn Header="Age" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AgeLabel}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Gender" Binding="{Binding Gender, Converter={StaticResource GenderLabelConverter}}" Width="90" />
                    <DataGridTextColumn Header="Last Visit" Binding="{Binding LastVisitDate, Converter={StaticResource NullableDateConverter}}" Width="120" />
                    <DataGridTextColumn Header="Next Appt" Binding="{Binding NextAppointmentDate, Converter={StaticResource NullableDateConverter}}" Width="120" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding ChiefComplaint}" Width="*" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding OutstandingMinor, Converter={StaticResource MoneyConverter}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="PageInfo" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevButton" Content="&#xE76B;" Style="{StaticResource IconButton}" Width="34" Click="OnPrevPage" />
                <Button x:Name="NextButton" Content="&#xE76C;" Style="{StaticResource IconButton}" Width="34" Click="OnNextPage" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
