<UserControl x:Class="Dentiva.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="26,22,26,26" MaxWidth="1560" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="GreetingText" Style="{StaticResource Text.Title}" />
                        <TextBlock x:Name="DateLine" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="NewPatientButton" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="OnNewPatient">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="New Patient" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewAppointmentButton" Style="{StaticResource TintedButton}" Padding="14,8" Margin="10,0,0,0" Click="OnNewAppointment">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="New Appointment" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Left column -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <!-- Stats -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock x:Name="StatAppointments" Text="0" FontFamily="{DynamicResource Font.Bold}" FontSize="26" Margin="0,10,0,0" />
                            <TextBlock Text="Appointments today" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource Brush.Warning}" />
                            <TextBlock x:Name="StatWaiting" Text="0" FontFamily="{DynamicResource Font.Bold}" FontSize="26" Margin="0,10,0,0" />
                            <TextBlock Text="Waiting patients" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource Brush.Danger}" />
                            <TextBlock x:Name="StatOutstanding" Text="0" FontFamily="{DynamicResource Font.Bold}" FontSize="26" Margin="0,10,0,0" />
                            <TextBlock Text="Outstanding balance" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Today's queue -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="20,16,20,10">
                            <StackPanel>
                                <TextBlock Text="Today's Queue" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock x:Name="QueueSummary" Style="{StaticResource Text.Small}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="Open schedule" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenSchedule" />
                        </Grid>
                        <Separator Margin="0" />
                        <DataGrid x:Name="QueueGrid" MinHeight="120" MaxHeight="420" Margin="8,4,8,12" ItemsSource="{Binding}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="64" />
                                <DataGridTextColumn Header="Time" Binding="{Binding StartTime, Converter={StaticResource TimeConverter}}" Width="76" />
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AppointmentType}" Width="130" />
                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}"
                                                    CornerRadius="999" Padding="10,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                                           FontSize="11" FontFamily="{DynamicResource Font.Medium}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Recent patients -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Margin="20,16,20,10">
                            <TextBlock Text="Recent Patients" Style="{StaticResource Text.Subtitle}" />
                        </Grid>
                        <Separator Margin="0" />
                        <ItemsControl x:Name="RecentPatients" Margin="10,8,10,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Margin="4,2"
                                            Click="OnOpenPatient" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Brush.AccentSubtle}">
                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                           FontSize="11" FontFamily="{DynamicResource Font.SemiBold}"
                                                           Foreground="{StaticResource Brush.AccentInk}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FullName}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium" />
                                            <TextBlock Grid.Column="2" Text="{Binding Code}" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Caption}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="20,16,20,10">
                            <TextBlock Text="Follow-ups Due" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock x:Name="FollowUpCount" Text="0" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Separator Margin="0" />
                        <ItemsControl x:Name="FollowUps" Margin="10,8,10,14" MinHeight="40">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Margin="4,2"
                                            Click="OnOpenPatient" Tag="{Binding PatientId}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PatientName}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding FollowUpDate, Converter={StaticResource DateConverter}}"
                                                           Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Diagnosis}" Style="{StaticResource Text.Small}"
                                                       VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Margin="20,16,20,10">
                            <TextBlock Text="Reminders" Style="{StaticResource Text.Subtitle}" />
                        </Grid>
                        <Separator Margin="0" />
                        <ItemsControl x:Name="Reminders" Margin="10,8,10,14" MinHeight="40">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="4,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Font.Medium}" FontSize="{StaticResource FontSize.Small}" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" MaxHeight="40" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
